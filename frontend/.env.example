# AttendSure environment template.
# Copy to .env.local (never committed) and fill in real values.
# On Vercel, set the same variables under Project Settings -> Environment Variables.

# -- Supabase (Dashboard -> Project Settings -> API) --------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -- Encryption keys (server-only, base64) ------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(N).toString('base64'))"
# Changing a key later makes existing encrypted data / QR passes unreadable.
# TDES_ENCRYPTION_KEY: N=24 (three distinct 8-byte subkeys). The other three: N=32 or more.
TDES_ENCRYPTION_KEY=
TDES_MAC_KEY=
STUDENT_ID_LOOKUP_KEY=
QR_TOKEN_SECRET=

# -- Application ---------------------------------------------------------------
APP_URL=http://localhost:3000
# Optional: extra check that registration emails end in this domain.
SCHOOL_EMAIL_DOMAIN=
